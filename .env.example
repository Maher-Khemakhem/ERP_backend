# This file is loaded automatically for local development when copied to .env.
# Do not put real secrets in this file or commit a local .env file.

# Required: at least 32 random bytes, encoded as text.
JWT_SECRET=UgxppHDH1rX8tV2cWgpajsbY3H1igpSjwhnnk4eF8Xs

JWT_ISSUER=supermarket-erp
JWT_AUDIENCE=supermarket-web
JWT_EXPIRATION_SECONDS=900

# Login throttling: 30 attempts/minute per IP and 10 attempts/minute per username.
LOGIN_RATE_LIMIT_IP_CAPACITY=30
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_USERNAME_CAPACITY=10
LOGIN_RATE_LIMIT_USERNAME_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_BUCKETS=10000

# Production deployments should also provide these without defaults:
# DB_URL=jdbc:postgresql://...
# DB_USERNAME=...
# DB_PASSWORD=...
